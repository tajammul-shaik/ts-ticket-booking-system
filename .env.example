# Optional overrides for docker compose. Copy to .env (git-ignored) and edit; compose reads .env
# from this directory automatically. With no .env at all, local-only defaults are used.
#
# Format: KEY=VALUE, no quotes, no `export`.

# --- Secrets (set real ones for anything shared) ---------------------------------------
# HS256 signing key, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
# X-Admin-Secret value that yields an admin token:  openssl rand -hex 24
ADMIN_SECRET=local-admin-secret

# --- Database (applied by MySQL only on the FIRST boot of an empty volume) --------------
# After changing these, recreate the volume: docker compose down -v
DATABASE_NAME=ticketing
DATABASE_USERNAME=ticketing
DATABASE_PASSWORD=ticketing
MYSQL_ROOT_PASSWORD=root

# --- Host ports ------------------------------------------------------------------------
APP_HOST_PORT=8080
MYSQL_HOST_PORT=3308

# --- Tuning (defaults shown; see LOAD-TESTING.md) ----------------------------------------
# DB_POOL_SIZE=10
# ADMISSION_MAX_IN_FLIGHT=64
# ADMISSION_MAX_QUEUED=1000
# ADMISSION_ACQUIRE_TIMEOUT=5s
# RATE_LIMIT_USER_RATE=20
# RATE_LIMIT_USER_BURST=40
